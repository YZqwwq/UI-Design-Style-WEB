# Copy to .env only when setting up a new checkout. Do not overwrite existing credentials.
# dev / database tests require PGDATABASE-test, PGUSER-test, PGPASSWORD-test.
# npm start uses the production PGDATABASE, PGUSER, PGPASSWORD keys.
# Missing test credentials never fall back to production. Database names must differ.
# PGHOST / PGPORT / PGSSLMODE are shared; optional *-test variants override them in dev.
PGHOST=47.100.225.90
PGPORT=5432

PGDATABASE=""
PGUSER=""
PGPASSWORD=""
PGSSLMODE=disable
PGCONNECT_TIMEOUT=10

PGDATABASE-test=""
PGUSER-test=""
PGPASSWORD-test=""
PGSSLMODE=disable
PGCONNECT_TIMEOUT=10



# 构建后统一服务端口；开发端口在终端通过 WEB_PORT / API_PORT 设置。
PORT=4173

# 公网部署填写浏览器访问的 HTTPS 源地址（不含结尾斜杠）；本地默认允许 localhost/127.0.0.1。
# APP_ORIGIN=https://design.example.com

# 阿里云邮件推送 DirectMail（API 发信，非 SMTP）。
# 后端已读取这些配置；缺少邮件凭据时发送验证码和新注册返回服务不可用，已有账号仍可登录。
# 验证码摘要使用 AccessKey Secret 加用途标识生成 HMAC；轮换密钥后尚未使用的验证码需重新获取。
# 仅供后端使用；将需要的配置追加到已有 .env，不要覆盖原有数据库配置。
MAIL_PROVIDER=aliyun

# 使用已绑定 DesignAtlasSendMail 策略的 RAM 用户凭据，不填写主账号密钥。
# 示例文件中始终留空，真实凭据仅填写在本地 .env 或部署环境中。
ALIBABA_CLOUD_ACCESS_KEY_ID=""
ALIBABA_CLOUD_ACCESS_KEY_SECRET=""

# 必须与 DirectMail 发信地址所在地域一致；杭州为 cn-hangzhou，确认后填写。
ALIYUN_DM_REGION_ID=""

# 已创建的触发邮件发信地址，以及收件人看到的发件人名称。
MAIL_FROM_ADDRESS=noreply@taliaterritory.com
MAIL_FROM_NAME="设计图鉴"

# 默认不启用回信地址；启用前需在 DirectMail 配置并验证回信邮箱。
MAIL_REPLY_TO_ENABLED=false
