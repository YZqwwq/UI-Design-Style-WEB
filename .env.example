# Copy to .env only when setting up a new checkout. Do not overwrite existing credentials.
# dev / database tests require PGDATABASE-test, PGUSER-test, PGPASSWORD-test.
# npm start uses the production PGDATABASE, PGUSER, PGPASSWORD keys.
# Missing test credentials never fall back to production. Database names must differ.
# PGHOST / PGPORT / PGSSLMODE are shared; optional *-test variants override them in dev.
PGHOST=47.100.225.90
PGPORT=5432

PGDATABASE=""
PGUSER=""
PGPASSWORD=""
PGSSLMODE=disable
PGCONNECT_TIMEOUT=10

PGDATABASE-test=""
PGUSER-test=""
PGPASSWORD-test=""
PGSSLMODE=disable
PGCONNECT_TIMEOUT=10



# 构建后统一服务端口；开发端口在终端通过 WEB_PORT / API_PORT 设置。
PORT=4173

# 公网部署填写浏览器访问的 HTTPS 源地址（不含结尾斜杠）；本地默认允许 localhost/127.0.0.1。
# APP_ORIGIN=https://design.example.com
