{
  "name": "@design-atlas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/src/main.js --production",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "db:check": "node --import tsx src/db-command.ts check",
    "db:migrate": "node --import tsx src/db-command.ts migrate",
    "test:db": "node --import tsx --test tests/database.integration.ts",
    "test:auth:db": "node --import tsx --test tests/auth.integration.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
